<style>
:root{font-family:system-ui,-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:#23342e;background:#f8f5ef}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,.movie:focus-visible{outline:3px solid #cc9b3c;outline-offset:2px}.hero{background:#174b3c;color:white;padding:42px 20px 56px;text-align:center;position:relative;overflow:hidden}.hero:before{content:'✦  ✧    ✦       ✧   ✦';position:absolute;inset:15px 0 auto;opacity:.27;letter-spacing:25px;white-space:nowrap}.eyebrow{color:#ffdb9c;font-size:13px;letter-spacing:3px;font-weight:800}.hero h1{font-size:clamp(26px,4vw,46px);line-height:1.2;margin:12px 0}.hero p{color:#e1eee8;margin:0}.shell{max-width:1080px;margin:-28px auto 50px;padding:0 18px;position:relative}.panel{background:#fff;border:1px solid #e9e3d7;border-radius:20px;padding:22px;box-shadow:0 8px 30px #243f3010;margin-bottom:18px}.panel h2{margin:0 0 14px;font-size:20px}.intro{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.counter{font-size:14px;color:#576b61}.input-grid{display:grid;grid-template-columns:minmax(160px,2fr) minmax(115px,1fr) minmax(145px,1fr) auto;gap:10px;align-items:end}.field{display:flex;flex-direction:column;gap:6px;font-weight:650;font-size:13px}.field input,.field select{height:43px;border:1px solid #d7ddd6;border-radius:10px;padding:0 11px;background:#fff;color:#23342e;min-width:0}.btn{background:#18634b;border:0;border-radius:10px;color:#fff;padding:11px 16px;font-weight:750;min-height:43px}.btn:hover{background:#0e4835}.btn.secondary{background:#f2f3f0;color:#37594a;border:1px solid #dce4dc}.btn.secondary:hover{background:#e6ece7}.btn.danger{background:#fff3f1;color:#a4372e;border:1px solid #efc7c1}.hint{font-size:12px;color:#66766e;margin:10px 0 0}.error{color:#98311e;font-size:14px;font-weight:700;min-height:18px;margin:12px 0 0;line-height:1.5}.tiers{display:flex;flex-direction:column;gap:10px}.tier{display:grid;grid-template-columns:145px minmax(0,1fr);border:1px solid #e6e7df;border-radius:15px;overflow:hidden;background:#fff;min-height:112px}.tier-label{padding:15px;color:#fff;display:flex;flex-direction:column;justify-content:center;gap:5px}.tier-label strong{font-size:30px;line-height:1}.tier-label span{font-size:12px;line-height:1.45}.tier[data-tier=S] .tier-label{background:#a92c36}.tier[data-tier=A] .tier-label{background:#c17b34}.tier[data-tier=B] .tier-label{background:#6f8560}.tier[data-tier=C] .tier-label{background:#667e9d}.tier[data-tier=unranked] .tier-label{background:#526960}.dropzone{padding:14px;display:flex;flex-wrap:wrap;align-content:center;align-items:center;gap:10px;min-height:110px}.tier.over{outline:3px dashed #bf9258;outline-offset:-4px;background:#fffbf3}.empty{color:#94a49a;font-size:14px}.movie{border:1px solid #e3e6df;border-radius:12px;background:#fff;box-shadow:0 3px 9px #26443810;min-width:165px;max-width:100%;padding:11px 12px;cursor:grab;text-align:left}.movie:hover{border-color:#a4b9aa;box-shadow:0 5px 14px #2644381c}.movie:active{cursor:grabbing}.movie-title{font-size:15px;font-weight:800;overflow-wrap:anywhere}.movie-meta{font-size:12px;color:#75847b;margin-top:5px}.movie-guide{font-size:11px;color:#9a8879;margin-top:7px}.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.foot{text-align:center;color:#7b877e;font-size:12px;padding:4px}dialog{border:0;border-radius:18px;padding:0;width:min(460px,calc(100vw - 30px));max-height:90vh;box-shadow:0 25px 80px #0004}dialog::backdrop{background:#102a20a8}.modal-body{padding:24px}.modal-body h2{margin:0 0 8px}.modal-body p{font-size:13px;color:#67766b;line-height:1.5}.modal-fields{display:grid;gap:13px;margin:20px 0}.modal-actions{display:flex;justify-content:space-between;gap:9px;flex-wrap:wrap}.modal-actions .right{display:flex;gap:8px}.tier-picker{display:flex;gap:7px;flex-wrap:wrap}.tier-picker button{background:#edf2ee;border:1px solid #d9e2db;border-radius:9px;padding:8px 11px;font-weight:750;color:#315445}.tier-picker button[aria-pressed=true]{background:#215e49;color:#fff;border-color:#215e49}@media(max-width:760px){.input-grid{grid-template-columns:1fr 1fr}.input-grid .field:first-child{grid-column:1/-1}.input-grid>.btn{align-self:end}.tier{grid-template-columns:100px minmax(0,1fr)}.tier-label{padding:10px}.tier-label strong{font-size:25px}.tier-label span{font-size:11px}.dropzone{padding:9px}.movie{min-width:0;width:100%}}@media(max-width:430px){.input-grid{grid-template-columns:1fr}.input-grid .field:first-child{grid-column:auto}.hero{padding-bottom:48px}.panel{padding:16px}.tier{grid-template-columns:86px minmax(0,1fr)}.modal-actions{display:block}.modal-actions .right{margin-top:10px}.modal-actions .right button{flex:1}}
.poster-image{width:92px;height:126px;object-fit:cover;border-radius:8px;display:block;margin:0 auto 8px}.poster-placeholder{height:126px;width:92px;margin:0 auto 8px;border-radius:8px;background:linear-gradient(145deg,#184935,#9f2836);color:#fff;display:flex;align-items:center;justify-content:center;font-size:30px}.movie{width:180px}.movie-title{display:block;color:#1d3329;font-size:16px;line-height:1.45;min-height:24px}.field input[type=file]{height:auto;padding:8px;background:white}@media(max-width:760px){.movie{width:100%}}.ott-field{grid-column:1/-1}.ott-options{display:flex;flex-wrap:wrap;gap:8px}.ott-options label{display:inline-flex;align-items:center;gap:5px;background:#f1f5f1;border:1px solid #dce7df;border-radius:8px;padding:8px 10px;font-size:13px;cursor:pointer}.ott-options input{width:16px;height:16px;accent-color:#18634b}.movie-ott{font-size:12px;font-weight:700;color:#32634c;margin-top:7px;overflow-wrap:anywhere}.modal-fields .field input[type=file]{height:auto;padding:8px}.ott-note{font-size:12px;color:#67766b;margin:5px 0 0}

/* 영화 등록과 보관함을 한 줄에 배치 */
.workspace{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;align-items:start}
.workspace-column{min-width:0}
.workspace-column + .workspace-column{border-left:0;border-top:1px solid #e9e3d7;padding-left:0;padding-top:24px}
.workspace .input-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.workspace .input-grid .field:first-child,.workspace .ott-field{grid-column:1/-1}
.workspace .input-grid>.btn{grid-column:1/-1;width:100%}
.library-bar{display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
.library-bar label{font-size:13px;font-weight:700}
.library-bar select{height:41px;border:1px solid #d7ddd6;border-radius:9px;padding:0 9px;min-width:140px;max-width:100%;background:white;color:#23342e}
.library-zone{min-height:260px;background:#fafbf9;border:2px dashed #d9e3db;border-radius:14px;padding:12px;display:flex;flex-wrap:wrap;align-content:flex-start;gap:10px}
.library-zone.over{background:#fff9e9;border-color:#bf9258}
.library-zone .movie{width:180px;min-width:125px}
.library-zone .movie .poster-image,.library-zone .movie .poster-placeholder{max-width:100%}
.library-zone .empty{align-self:center;text-align:center;width:100%;line-height:1.6}
@media(max-width:820px){.workspace{grid-template-columns:1fr}.workspace-column + .workspace-column{border-left:0;border-top:1px solid #e9e3d7;padding-left:0;padding-top:20px}.library-zone{min-height:150px}}
@media(max-width:430px){.workspace .input-grid{grid-template-columns:1fr}.library-zone .movie{width:calc(50% - 5px);min-width:0}}
.share-actions{display:flex;gap:10px;flex-wrap:wrap}.share-actions .secondary{background:#eef3ee;color:#215e49;border:1px solid #cbdcd0}.movie img{max-width:100%}@media(max-width:430px){.share-actions button{width:100%}}</style>
